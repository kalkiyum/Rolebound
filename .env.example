# --- Database (provisioned in step 1.3) ---
DATABASE_URL=

# The test suite wipes every table between cases, so it runs against its own
# database, created and migrated automatically on the first `pnpm test`.
TEST_DATABASE_URL=postgres://localhost:5432/rolebound_test

# --- Privy (step 0.1 — blocks the phase 0 spike) ---
# App with SERVER WALLETS enabled.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key for server-wallet signing (P-256 private key).
PRIVY_AUTHORIZATION_KEY=

# --- Chain (step 1.6) ---
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_ROLEBOUND_PAY_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Guards POST /api/cron/sweep, which moves money. Unset means the endpoint
# refuses every request — an unguarded sweep is worse than one that never runs.
CRON_SECRET=
